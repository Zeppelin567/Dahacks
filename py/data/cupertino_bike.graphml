    <edge source="8678222160" target="3315655994" id="0">
      <data key="d12">8961287</data>
      <data key="d15">residential</data>
      <data key="d18">Olga Drive</data>
      <data key="d19">False</data>
      <data key="d21">False</data>
      <data key="d22">5.838845525040991</data>
      <data key="d27">536.8098781526484</data>
      <data key="d28">1778.567494833037</data>
      <data key="d29">0</data>
      <data key="d30">0.8</data>
      <data key="d31">photo</data>
      <data key="d32">Quiet residential street with parked cars and no bike lane; low traffic makes it comfortable for careful riders.</data>
      <data key="d33">door_zone</data>
      <data key="d34">medium</data>
      <data key="d35">3.222</data>
      <data key="d36">0.2</data>
      <data key="d37">Residential street with young and sparse street trees on one side, mostly pavement and buildings overhead.</data>
    </edge>
    <edge source="8678222160" target="6228044675" id="0">
      <data key="d12">8961287</data>
      <data key="d15">residential</data>
      <data key="d18">Olga Drive</data>
      <data key="d19">False</data>
      <data key="d21">True</data>
      <data key="d22">12.898081370606652</data>
      <data key="d27">538.1444204844703</data>
      <data key="d28">1784.113468267351</data>
      <data key="d29">0</data>
      <data key="d30">0.8</data>
      <data key="d31">photo</data>
      <data key="d32">Quiet residential street with light traffic and good pavement, though parked cars create some door risk.</data>
      <data key="d33">door_zone</data>
      <data key="d34">medium</data>
      <data key="d35">3.222</data>
      <data key="d36">0.2</data>
      <data key="d37">Some young street trees on one side and modest planting along the curb; little canopy over the road.</data>
    </edge>

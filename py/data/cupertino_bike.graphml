      <data key="d31">photo</data>
      <data key="d32">Painted bike lane on a one-way road with clear sight lines, but many parking-lot driveways cross the lane.</data>
      <data key="d33">frequent_driveways</data>
      <data key="d34">medium</data>
      <data key="d35">3.222</data>
      <data key="d36">0.3</data>
      <data key="d37">Street trees on one side and planted strips, but the other side is a commercial parking lot with little canopy.</data>
    </edge>

      <data key="d22">4.45935245868531</data>
      <data key="d41">BIKE LANE</data>
      <data key="d42">II</data>
      <data key="d27">220.90739544457182</data>
      <data key="d28">628.2560266737877</data>
      <data key="d29">0</data>
      <data key="d30">0.7</data>
      <data key="d31">photo</data>
      <data key="d32">Painted bike lane on a quiet two-lane residential road, with some parked cars near the riding line.</data>
      <data key="d33">door_zone</data>
      <data key="d34">medium</data>
      <data key="d35">3.222</data>
      <data key="d36">0.2</data>
      <data key="d37">Tall conifers line one side and shrubs add some planting, but the road is open with little canopy overhead.</data>
    </edge>
    <edge source="1293729039" target="5233973491" id="0">
      <data key="d12">936582800</data>
      <data key="d24">shared_lane</data>

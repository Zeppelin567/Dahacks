      <data key="d31">photo</data>
      <data key="d32">Painted bike lane on a one-way 35 mph street with clear sight lines, though parked cars create door-zone risk.</data>
      <data key="d33">door_zone</data>
      <data key="d34">high</data>
      <data key="d35">2.333</data>
      <data key="d36">0.2</data>

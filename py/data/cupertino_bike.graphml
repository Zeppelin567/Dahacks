    <edge source="4913435471" target="4913435512" id="0">
      <data key="d12">413367106</data>
      <data key="d24">shared_lane</data>
      <data key="d15">unclassified</data>
      <data key="d17">25 mph</data>
      <data key="d18">Valley Green Drive</data>
      <data key="d19">False</data>
      <data key="d21">True</data>
      <data key="d22">11.963251083451869</data>
      <data key="d41">BIKE ROUTE</data>
      <data key="d42">III</data>
      <data key="d27">80.66580041698428</data>
      <data key="d28">1266.8982131390626</data>
      <data key="d29">1</data>
      <data key="d30">0.9</data>
      <data key="d31">photo</data>
      <data key="d32">Quiet 25 mph residential-style street with wide clear pavement; only shared-lane markings, no bike lane.</data>
      <data key="d33">sharrows_only</data>
      <data key="d34">high</data>
      <data key="d35">3.667</data>
      <data key="d36">0.3</data>
      <data key="d37">Tall mature trees line both sides with some gaps; office buildings and a wide pavement still dominate the view.</data>
    </edge>
    <edge source="4913435471" target="4913435508" id="0">
      <data key="d12">413367106</data>
      <data key="d24">shared_lane</data>
      <data key="d15">unclassified</data>
      <data key="d17">25 mph</data>
      <data key="d18">Valley Green Drive</data>
      <data key="d19">False</data>
      <data key="d21">False</data>
      <data key="d22">59.858932584326844</data>
      <data key="d26">LINESTRING (-122.0360757 37.3322859, -122.03612 37.3322635, -122.0361697 37.3322358, -122.0362344 37.332195, -122.0362874 37.3321604, -122.0363523 37.3321147, -122.0364808 37.3320526, -122.0365819 37.3320197, -122.036646 37.332006)</data>
      <data key="d41">BIKE ROUTE</data>
      <data key="d42">III</data>
      <data key="d27">34.73202804492052</data>
      <data key="d28">1208.4857190767193</data>
      <data key="d29">2</data>
      <data key="d30">0.8</data>
      <data key="d31">photo</data>
      <data key="d32">Quiet 25 mph residential street with wide lanes and good pavement; shared-lane markings only, but low traffic stress.</data>
      <data key="d33">sharrows_only</data>
      <data key="d34">high</data>
      <data key="d35">3.667</data>
      <data key="d36">0.4</data>
      <data key="d37">Tall mature trees and shrub planting line this quiet street, though canopy over the road has gaps and buildings are visible.</data>
    </edge>
    <edge source="4913435471" target="4913435472" id="0">
      <data key="d12">500243934</data>
      <data key="d15">service</data>
      <data key="d40">parking_aisle</data>
      <data key="d19">False</data>

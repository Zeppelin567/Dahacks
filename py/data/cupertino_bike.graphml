      <data key="d31">photo</data>
      <data key="d32">Quiet residential hill street with clear sightlines and little traffic, though no bike lane and speed unmapped.</data>
      <data key="d33">no_bike_lane</data>
      <data key="d34">medium</data>
      <data key="d35">4.111</data>

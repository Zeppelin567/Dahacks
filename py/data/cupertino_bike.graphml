    <edge source="4913435495" target="4913435504" id="0">
      <data key="d12">8944926</data>
      <data key="d15">unclassified</data>
      <data key="d17">25 mph</data>
      <data key="d18">Valley Green Drive</data>
      <data key="d19">False</data>
      <data key="d21">False</data>
      <data key="d22">20.839487376862188</data>
      <data key="d27">192.1147218516051</data>
      <data key="d28">1372.5949934506148</data>
      <data key="d29">1</data>
      <data key="d30">0.8</data>
      <data key="d31">photo</data>
      <data key="d32">Quiet residential street with a 25 mph limit, light traffic, and good pavement; suitable for most riders.</data>
      <data key="d33" />
      <data key="d34">high</data>
      <data key="d35">3.667</data>
      <data key="d36">0.3</data>
      <data key="d37">Tree-lined residential street with mature trees on both sides and partial canopy, though gaps and parked cars reduce greenery.</data>
    </edge>
    <edge source="4913435495" target="4913435935" id="0">
      <data key="d12">8944926</data>
      <data key="d15">unclassified</data>
      <data key="d17">25 mph</data>
      <data key="d18">Valley Green Drive</data>
      <data key="d19">False</data>
      <data key="d21">True</data>
      <data key="d22">54.48335191356174</data>
      <data key="d26">LINESTRING (-122.0343522 37.3323441, -122.0340399 37.3323445, -122.0338699 37.3323282, -122.0337454 37.3322917)</data>
      <data key="d27">184.98396678922975</data>
      <data key="d28">1389.1859259272735</data>
      <data key="d29">1</data>
      <data key="d30">0.9</data>
      <data key="d31">photo</data>
      <data key="d32">Quiet 25 mph business-park road with wide edge space, good pavement and clear sight lines.</data>
      <data key="d33" />
      <data key="d34">high</data>
      <data key="d35">3.222</data>
      <data key="d36">0.2</data>
      <data key="d37">Scattered mature trees and shrubby planting along the road, but wide pavement and parked cars dominate the view.</data>
    </edge>

    <edge source="11388892976" target="4913164964" id="0">
      <data key="d12">1228130014</data>
      <data key="d15">residential</data>
      <data key="d18">Creekwood Drive</data>
      <data key="d19">False</data>
      <data key="d21">True</data>
      <data key="d22">11.339714193397278</data>
      <data key="d27">86.50562405280563</data>
      <data key="d28">1316.617416742397</data>
      <data key="d29">0</data>
      <data key="d30">0.8</data>
      <data key="d31">photo</data>
      <data key="d32">Quiet residential cul-de-sac-style street with light traffic, no bike lane needed; many driveways and parked cars.</data>
      <data key="d33">frequent_driveways</data>
      <data key="d34">high</data>
      <data key="d35">3.667</data>
      <data key="d36">0.3</data>
      <data key="d37">Tree-lined residential cul-de-sac with mature trees and planted front yards, though canopy over the road has gaps.</data>
    </edge>

      <data key="d30">0.8</data>
      <data key="d31">photo</data>
      <data key="d32">Quiet residential street with parked cars and driveways; door zone risk, but low traffic and clear sight lines.</data>
      <data key="d33">door_zone</data>
      <data key="d34">medium</data>
      <data key="d35">3.222</data>
      <data key="d36">0.3</data>
      <data key="d37">Residential street with large street trees on both sides, but canopy is partial and no nearby park or creek.</data>
    </edge>

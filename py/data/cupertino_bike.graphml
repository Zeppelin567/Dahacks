      <data key="d29">0</data>
      <data key="d30">0.8</data>
      <data key="d31">photo</data>
      <data key="d32">Quiet 25 mph residential street with clear sight lines; driveways and parked cars call for some care.</data>
      <data key="d33">frequent_driveways</data>
      <data key="d34">high</data>
      <data key="d35">2.778</data>
      <data key="d36">0.2</data>
      <data key="d37">Residential street with scattered young trees and some shrubs, but a commercial lot and wide pavement dominate the view.</data>
    </edge>
    <edge source="2069326202" target="1700007811" id="0">
      <data key="d12">8945826</data>
      <data key="d15">residential</data>

    <edge source="3494446024" target="12697943342" id="0">
      <data key="d12">8961911</data>
      <data key="d15">residential</data>
      <data key="d18">Scenic Boulevard</data>
      <data key="d19">False</data>
      <data key="d21">False</data>
      <data key="d22">6.149399700693058</data>
      <data key="d27">82.19817056879863</data>
      <data key="d28">766.4314283953063</data>
      <data key="d29">0</data>
      <data key="d30">0.8</data>
      <data key="d31">photo</data>
      <data key="d32">Quiet residential street with parked cars and driveways; no bike lane but low traffic makes it comfortable.</data>
      <data key="d33">door_zone,no_bike_lane</data>
      <data key="d34">medium</data>
      <data key="d35">3.667</data>
      <data key="d36">0.3</data>
      <data key="d37">Tree-lined residential street with mature trees and shrub planting, though canopy has gaps and parked cars show.</data>
    </edge>
    <edge source="3494446024" target="12697943329" id="0">
      <data key="d12">8961911</data>
      <data key="d15">residential</data>
      <data key="d18">Scenic Boulevard</data>

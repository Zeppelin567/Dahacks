      <data key="d29">0</data>
      <data key="d30">0.7</data>
      <data key="d31">photo</data>
      <data key="d32">Painted bike lane on a 25 mph road with clear sight lines, though a right-turn lane runs alongside.</data>
      <data key="d33">bike_lane_between_turn_lanes</data>
      <data key="d34">medium</data>
      <data key="d35">2.333</data>
      <data key="d36">0.1</data>
      <data key="d37">Wide intersection with pavement and bank and gas station; only a few scattered trees and small planting strips.</data>
    </edge>
    <edge source="2496987241" target="7136645167" id="0">
      <data key="d12">[499994493, 957080735]</data>

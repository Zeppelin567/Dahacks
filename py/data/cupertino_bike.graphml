      <data key="d21">False</data>
      <data key="d22">10.69801625517077</data>
      <data key="d41">SEPARATED BIKEWAY</data>
      <data key="d42">IV</data>
      <data key="d27">188.72569050816412</data>
      <data key="d28">725.3390289253678</data>
      <data key="d29">0</data>
      <data key="d30">0.7</data>
      <data key="d31">photo</data>
      <data key="d32">Painted bike lane with some parked cars and a quiet, low-traffic residential feel; door zone is the main concern.</data>
      <data key="d33">door_zone</data>
      <data key="d34">medium</data>
      <data key="d35">3.222</data>
      <data key="d36">0.2</data>
      <data key="d37">Tall conifers and a few street trees line one side, but canopy over the road is only partial.</data>
    </edge>
    <edge source="5023140151" target="65435466" id="0">
      <data key="d12">[514041314, 500201135]</data>
      <data key="d13">lane</data>
      <data key="d14">shared_lane</data>
      <data key="d15">tertiary</data>
      <data key="d46">yes</data>
      <data key="d18">Mary Avenue</data>

      <data key="d31">photo</data>
      <data key="d32">Quiet residential street with light traffic and good visibility; no bike lane, but low speeds make riding comfortable.</data>
      <data key="d33">door_zone,frequent_driveways</data>
      <data key="d34">medium</data>

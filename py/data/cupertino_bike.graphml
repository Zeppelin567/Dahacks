    <edge source="4913404508" target="317528773" id="0">
      <data key="d12">415858572</data>
      <data key="d14">lane</data>
      <data key="d44">no</data>
      <data key="d15">primary</data>
      <data key="d16">4</data>
      <data key="d17">40 mph</data>
      <data key="d18">Saratoga Avenue</data>
      <data key="d19">True</data>
      <data key="d23">left|||</data>
      <data key="d21">False</data>
      <data key="d22">69.8398373626215</data>
      <data key="d26">LINESTRING (-121.9776413 37.308772, -121.9776652 37.3086507, -121.97774 37.3082868, -121.9777439 37.3082693, -121.9777705 37.3081524)</data>
      <data key="d27">605.9701073730826</data>
      <data key="d28">1780.709597788641</data>
      <data key="d29">0</data>
      <data key="d30">0.6</data>
      <data key="d31">photo</data>
      <data key="d32">Painted bike lane on a 40 mph one-way arterial with narrow edge space; workable but traffic is fast.</data>
      <data key="d33">high_speed_traffic</data>
      <data key="d34">medium</data>
      <data key="d35">2.333</data>
      <data key="d36">0.1</data>
      <data key="d37">Wide arterial with a few young trees and shrubs; mostly pavement, signs and commercial buildings in view.</data>
    </edge>
    <edge source="4913404508" target="4913404507" id="0">
      <data key="d12">500239768</data>

      <data key="d26">LINESTRING (-122.0320832 37.3161115, -122.0319924 37.3161514, -122.0319344 37.3161721, -122.0318539 37.3161854, -122.0317845 37.3161906, -122.0316353 37.3161937, -122.0315569 37.3161934)</data>

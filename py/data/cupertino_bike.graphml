      <data key="d19">False</data>
      <data key="d21">[False, True]</data>
      <data key="d22">138.07385348389204</data>
      <data key="d18">Coronado Drive</data>
      <data key="d26">LINESTRING (-122.0311192 37.302125, -122.0310195 37.3021593, -122.030929 37.3021863, -122.0307905 37.3022292, -122.0296945 37.3022417, -122.0296831 37.3022419, -122.0295835 37.302243)</data>

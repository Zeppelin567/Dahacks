      <data key="d33" />
      <data key="d34">high</data>
      <data key="d35">3.222</data>
      <data key="d36">0.2</data>
      <data key="d37">Street trees and shrubs line the road on one side, but the wide road and buildings dominate the view.</data>
    </edge>

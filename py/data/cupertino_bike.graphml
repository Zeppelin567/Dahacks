      <data key="d22">19.16310767727304</data>
      <data key="d26">LINESTRING (-122.0496774 37.3170479, -122.049665 37.3170739, -122.0496094 37.3172115)</data>
      <data key="d41">SEPARATED BIKEWAY</data>

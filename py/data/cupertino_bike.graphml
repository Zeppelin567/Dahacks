      <data key="d33">no_median_refuge</data>
      <data key="d34">high</data>
      <data key="d35">3.222</data>
      <data key="d36">0.3</data>
      <data key="d37">Mature trees and landscaped planting on the curb side, but the wide road and open sky keep canopy partial.</data>
    </edge>

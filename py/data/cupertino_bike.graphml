      <data key="d31">photo</data>
      <data key="d32">Quiet 25 mph residential street with clear sight lines; parked cars create some door-zone risk.</data>
      <data key="d33">door_zone</data>
      <data key="d34">high</data>
      <data key="d35">3.222</data>
      <data key="d36">0.2</data>

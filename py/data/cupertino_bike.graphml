      <data key="d31">photo</data>
      <data key="d32">Quiet residential court with light traffic and good pavement; mixed-traffic riding is comfortable.</data>
      <data key="d33" />
      <data key="d34">medium</data>
      <data key="d35">3.667</data>
      <data key="d36">0.3</data>

      <data key="d29">0</data>
      <data key="d30">0.8</data>
      <data key="d31">photo</data>
      <data key="d32">Quiet residential court with clear sight lines and good pavement; many driveways and some parked cars.</data>
      <data key="d33">frequent_driveways</data>
      <data key="d34">high</data>
      <data key="d35">2.333</data>
      <data key="d36">0.0</data>
      <data key="d37">Cul-de-sac with a few scattered trees and shrubs, but mostly pavement, driveways and parked cars.</data>
    </edge>

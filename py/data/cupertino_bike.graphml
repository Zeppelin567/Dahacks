    <edge source="13329347095" target="240274940" id="0">
      <data key="d12">4809389</data>
      <data key="d15">tertiary</data>
      <data key="d16">2</data>
      <data key="d17">30 mph</data>
      <data key="d18">Stevens Canyon Road</data>
      <data key="d20">asphalt</data>
      <data key="d19">False</data>
      <data key="d21">False</data>
      <data key="d22">69.56700256494719</data>
      <data key="d26">LINESTRING (-122.0716282 37.3082061, -122.0717403 37.3080486, -122.0719095 37.3078263, -122.0720989 37.3077193)</data>
      <data key="d41">BIKE ROUTE</data>
      <data key="d42">III</data>
      <data key="d27">5.086329809924227</data>
      <data key="d28">680.1949607625945</data>
      <data key="d29">0</data>
      <data key="d30">0.7</data>
      <data key="d31">photo</data>
      <data key="d32">Rural-feel two-lane road at 30 mph with no bike lane; narrow shoulder and curves limit sight lines.</data>
      <data key="d33">sharrows_only</data>
      <data key="d34">medium</data>
      <data key="d35">4.111</data>
      <data key="d36">0.3</data>
      <data key="d37">Mature oaks and cedars line a rural canyon road, with hills and open orchard land nearby.</data>
    </edge>
    <edge source="13329347095" target="240272885" id="0">
      <data key="d12">4809389</data>
      <data key="d15">tertiary</data>
      <data key="d16">2</data>
      <data key="d17">30 mph</data>
      <data key="d18">Stevens Canyon Road</data>

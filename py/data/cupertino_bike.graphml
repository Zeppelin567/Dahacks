      <data key="d29">0</data>
      <data key="d30">0.8</data>
      <data key="d31">photo</data>
      <data key="d32">Quiet residential street with no bike lane, but low speeds and light traffic; many driveways and an unclear view.</data>
      <data key="d33">frequent_driveways,no_bike_lane</data>
      <data key="d34">low</data>
      <data key="d35">2.778</data>
      <data key="d36">0.1</data>
      <data key="d37">Some shrubs, cypress and a few trees at a driveway entrance, but little canopy over the road and a parked car.</data>
    </edge>
    <edge source="1313766356" target="7748131844" id="0">
      <data key="d12">116556639</data>
      <data key="d15">residential</data>
      <data key="d18">Coronado Drive</data>

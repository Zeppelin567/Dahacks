      <data key="d28">116.11700466393583</data>
      <data key="d29">0</data>
      <data key="d30">0.9</data>
      <data key="d31">photo</data>
      <data key="d32">Mapped separated bikeway on a tertiary road with good pavement and clear sight lines; no bike path visible in photos.</data>
      <data key="d33" />
      <data key="d34">medium</data>
      <data key="d35">3.222</data>
      <data key="d36">0.2</data>
      <data key="d37">Mature trees and shrub planting line the road, but canopy over the street is only partial and buildings dominate.</data>
    </edge>
    <edge source="14006951021" target="2631750627" id="0">
      <data key="d12">[1537769148, 1537769149]</data>
      <data key="d43">yes</data>
      <data key="d13">['separate', 'track']</data>
      <data key="d14">lane</data>

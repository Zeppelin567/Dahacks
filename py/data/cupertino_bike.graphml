      <data key="d29">0</data>
      <data key="d30">0.7</data>
      <data key="d31">photo</data>
      <data key="d32">Painted bike lane on a 35 mph arterial with no parking; fairly comfortable for careful riders.</data>
      <data key="d33" />
      <data key="d34">high</data>
      <data key="d35">3.0</data>
      <data key="d36">0.2</data>
      <data key="d37">Large mature trees line the right side and a shaded park-like area sits beside the wide arterial, but the road itself is open and wide.</data>
    </edge>
    <edge source="2618769034" target="4379447067" id="0">
      <data key="d12">440222073</data>

      <data key="d31">photo</data>
      <data key="d32">Quiet one-way residential street with a mapped city bike lane; the curb side isn't visible, so the rating is provisional.</data>
      <data key="d33" />
      <data key="d34">low</data>
      <data key="d35">3.222</data>
      <data key="d36">0.2</data>
      <data key="d37">Gated entrance with mature trees and xeriscape beds on the right, but the road itself has little canopy over it.</data>
    </edge>
    <edge source="6507351850" target="65431097" id="0">
      <data key="d12">32837599</data>

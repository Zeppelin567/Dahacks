      <data key="d31">photo</data>
      <data key="d32">Private hotel-style driveway road with no bike lane, but quiet, wide and clear; speed and lanes unmapped.</data>
      <data key="d33">frequent_driveways</data>
      <data key="d34">medium</data>
      <data key="d35">3.222</data>
      <data key="d36">0.2</data>

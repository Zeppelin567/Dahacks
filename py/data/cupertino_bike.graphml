      <data key="d41">BIKE ROUTE</data>
      <data key="d42">III</data>
      <data key="d27">171.09325894269497</data>
      <data key="d28">1101.4148055648993</data>
      <data key="d29">0</data>
      <data key="d30">0.7</data>
      <data key="d31">photo</data>
      <data key="d32">Quiet 30 mph street with parked cars and no bike lane; sharrows only, so ride with care near doors.</data>
      <data key="d33">door_zone,sharrows_only</data>
      <data key="d34">high</data>
      <data key="d35">3.222</data>
      <data key="d36">0.2</data>
      <data key="d37">Tall conifers and a few mature trees line one side, but parked vans and pavement dominate the view.</data>
    </edge>
    <edge source="7204911092" target="65618918" id="0">
      <data key="d12">614365185</data>
      <data key="d24">shared_lane</data>

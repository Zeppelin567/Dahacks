      <data key="d30">0.5</data>
      <data key="d31">photo</data>
      <data key="d32">One-way 35 mph street with no bike lane and parked cars beside the lane; traffic is close and door risk is real.</data>
      <data key="d33">door_zone,no_bike_lane</data>
      <data key="d34">high</data>
      <data key="d35">3.222</data>
      <data key="d36">0.3</data>

      <data key="d29">0</data>
      <data key="d30">0.8</data>
      <data key="d31">photo</data>
      <data key="d32">Quiet residential court with wide, smooth pavement and clear sight lines; no bike lane but low traffic.</data>
      <data key="d33">frequent_driveways</data>
      <data key="d34">medium</data>
      <data key="d35">3.222</data>
      <data key="d36">0.1</data>
      <data key="d37">Residential street with some planted trees and shrubs, but canopy over the road is sparse and mostly hardscape.</data>
    </edge>
    <edge source="3385384500" target="3385384505" id="0">
      <data key="d12">521808485</data>

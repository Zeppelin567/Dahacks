      <data key="d31">photo</data>
      <data key="d32">Mapped painted bike lane on a 35 mph two-lane road, but construction and cracked pavement reduce comfort.</data>
      <data key="d33">construction,poor_pavement</data>
      <data key="d34">medium</data>
      <data key="d35">2.333</data>
      <data key="d36">0.1</data>
      <data key="d37">Wide intersection with pavement and construction cones; a few trees and a large oak beside the school bus yard.</data>
    </edge>
    <edge source="317526558" target="289681037" id="0">
      <data key="d12">279827507</data>

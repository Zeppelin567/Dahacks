      <data key="d22">72.5828961623821</data>
      <data key="d26">LINESTRING (-121.9960501 37.3051909, -121.9959564 37.3054119, -121.9959443 37.3054841, -121.995924 37.305522, -121.9958653 37.3055737, -121.9958185 37.3055993, -121.9957682 37.3056141, -121.9956753 37.3056265, -121.9955838 37.3056329)</data>

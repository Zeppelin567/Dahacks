      <data key="d30">0.8</data>
      <data key="d31">photo</data>
      <data key="d32">Quiet residential hillside street with good pavement and clear sightlines; no bike lane, but low traffic likely.</data>
      <data key="d33">no_bike_lane</data>
      <data key="d34">medium</data>
      <data key="d35">4.111</data>
      <data key="d36">0.2</data>
      <data key="d37">Dense mature trees and shrubs line both sides of a hillside residential road, with leaves in full summer foliage.</data>
    </edge>
    <edge source="13837881302" target="8022136261" id="0">

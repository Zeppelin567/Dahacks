      <data key="d29">0</data>
      <data key="d30">0.8</data>
      <data key="d31">photo</data>
      <data key="d32">Quiet residential street with parked cars and driveways; low traffic, so comfortable for cautious riders despite no bike lane.</data>
      <data key="d33">door_zone,frequent_driveways</data>
      <data key="d34">medium</data>
      <data key="d35">3.222</data>
      <data key="d36">0.2</data>
      <data key="d37">Residential street with some mature street trees on the left side, but canopy is patchy and parked cars and a storage container dominate the view.</data>
    </edge>
    <edge source="1313766354" target="65543481" id="0">
      <data key="d12">116556639</data>
      <data key="d15">residential</data>
      <data key="d18">Coronado Drive</data>
      <data key="d20">asphalt</data>
      <data key="d19">False</data>

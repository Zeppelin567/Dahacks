      <data key="d31">photo</data>
      <data key="d32">Quiet residential street with no bike lane and parked cars; manageable for confident riders, speed unmapped.</data>
      <data key="d33">door_zone</data>
      <data key="d34">medium</data>
      <data key="d35">2.778</data>
      <data key="d36">0.1</data>
      <data key="d37">Shrubby hedges on the right and one large tree on the left; little canopy over the road, mostly pavement.</data>
    </edge>

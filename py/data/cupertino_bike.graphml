      <data key="d29">0</data>
      <data key="d30">0.8</data>
      <data key="d31">photo</data>
      <data key="d32">Painted bike lane on a quiet one-way residential-style road with good pavement and clear sight lines.</data>
      <data key="d33" />
      <data key="d34">medium</data>
      <data key="d35">3.222</data>
      <data key="d36">0.2</data>
      <data key="d37">Some street trees and planted front yards, but a wide road with little canopy over it.</data>
    </edge>

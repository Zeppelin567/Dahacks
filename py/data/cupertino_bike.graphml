      <data key="d30">0.7</data>
      <data key="d31">photo</data>
      <data key="d32">Painted bike lane on a 35 mph one-way road with good pavement and clear sight lines.</data>
      <data key="d33" />
      <data key="d34">medium</data>
      <data key="d35">3.667</data>
      <data key="d36">0.35</data>
      <data key="d37">Tall conifers and shrubs line both sides, with gaps in the canopy over the road.</data>
    </edge>
    <edge source="6507351851" target="4183782184" id="0">
      <data key="d12">417907578</data>

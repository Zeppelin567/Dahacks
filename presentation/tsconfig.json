{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@mvp/shared": ["../shared/src/index.ts"]
    }
  },
  // Only the deck. The old recreated-app files (src/bikemap, pages, demo, scenes...) are no longer imported.
  "include": ["src/main.tsx", "src/presentation.tsx", "src/data.ts", "src/deck", "vite.config.ts"]
}

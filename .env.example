# Copy to .env at the repo root. Everything has a working default;
# the app runs with NO .env file at all (PGlite database, mock LLM).

# --- Server -----------------------------------------------------------
# PORT=3000
# NODE_ENV=development

# --- Database ---------------------------------------------------------
# Unset  -> embedded PGlite Postgres stored in api/.data (no install needed)
# Set    -> any Postgres URL (Neon, Supabase, Render, local...)
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- Auth -------------------------------------------------------------
# Generate a real one for production: `npx auth@latest secret`
# BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public URL of the API (where the browser reaches it). Dev default is fine.
# BETTER_AUTH_URL=http://localhost:3000

# --- LLM --------------------------------------------------------------
# Provider: anthropic | openai | google | mock. Falls back to mock when the
# chosen provider has no API key, so the app always runs.
# LLM_PROVIDER=anthropic
# Model id. Defaults: anthropic → claude-opus-5 (use claude-sonnet-5 for cheaper/faster),
# openai → gpt-5, google → gemini-2.5-flash. Verify the non-Anthropic ids against the vendor's list.
# LLM_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# --- Python service (optional) ---------------------------------------
# PY_URL=http://localhost:8000

# --- Bike map: Safe route pipeline (py/scripts/) ----------------------
# Google Cloud key restricted to "Street View Static API" (see .plans/actualproject.md §3)
# GOOGLE_MAPS_API_KEY=
# Scoring uses Claude: set ANTHROPIC_API_KEY in the LLM section above.
